# ==============================================================================
# Voice AI Receptionist - Environment Configuration
# ==============================================================================

# --- LiveKit WebRTC Cloud / Self-hosted ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI Providers ---
# Speech-to-Text: Deepgram nova-3
DEEPGRAM_API_KEY=your_deepgram_api_key

# Large Language Model: Groq llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key

# Text-to-Speech: ElevenLabs eleven_turbo_v2_5
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# --- Google Calendar Integration ---
# Either a local file path (e.g. ./service-account.json) OR a single-line minified JSON string
GOOGLE_CALENDAR_CREDENTIALS=./service-account.json
GOOGLE_CALENDAR_ID=primary

# --- Clinic / Business Configuration ---
BUSINESS_NAME=Apex Wellness Clinic
BUSINESS_TIMEZONE=Asia/Kolkata
OPEN_HOUR=9
CLOSE_HOUR=17
SLOT_MINUTES=30

# --- Token Server & Frontend Origin ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# --- Optional Model / Voice Overrides ---
# GROQ_MODEL=llama-3.3-70b-versatile
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

